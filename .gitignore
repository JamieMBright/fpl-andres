# Scraped source cache. Never redistributed; re-fetched on demand.
data/soccerdata/

# The swept manager catalogue is tracked: FPL500 is derived from it, and a
# derived ranking whose input is not in the repository cannot be reproduced or
# reviewed. It holds entry ids, season ranks and points — the same fields FPL
# publishes on a public league table, and no name, email or team name.
# The raw sweep working files stay out; only the catalogue and its checkpoint
# are kept.
data/cohort/*
!data/cohort/managers.jsonl
!data/cohort/sweep-checkpoint.json
!data/cohort/fpl500.json
!data/cohort/fpl100.json
!data/cohort/points-to-rank.json
!data/cohort/points-to-rank-sample.jsonl
!data/cohort/points-to-rank-sample-checkpoint.json
!data/cohort/absent.json
!data/cohort/agreement.json
!data/cohort/fpl500-membership/
!data/cohort/fpl500-membership/*.json
# What the cohort held, one file a gameweek. Small, and the only record there
# will ever be: FPL serves picks for the current season only, so a gameweek
# missed here cannot be recovered.
!data/cohort/portfolio/
!data/cohort/portfolio/*.json
!data/cohort/portfolio/fpl500/
!data/cohort/portfolio/fpl500/*.json

# Ownership and price series recovered from the fplcache archive. Bulk, and
# theirs to distribute rather than ours; re-fetched on demand.
data/ownership/
