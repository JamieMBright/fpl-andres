# Browser-safe values only use the VITE_ prefix.
VITE_API_BASE_URL=/api

# Database migration setup does not read this file. VS Code MCP is disabled by
# organization policy; follow the SQL Editor checklist in OWNER_SETUP.md.
# Add runtime values only when OWNER_SETUP.md says the relevant route/job is ready.
# Server-side values. Never prefix SUPABASE_SECRET_KEY with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
